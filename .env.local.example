# Propreté Business — Environment variables (example)
# Copy to .env.local and fill in. Never commit .env.local.

# ── Site ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://propretebusiness.fr

# ── Supabase ─────────────────────────────────────────────────────
# Created at https://app.supabase.com/. PostGIS extension required.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER-ONLY. Bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Email (Brevo / ex-Sendinblue) ────────────────────────────────
# Free tier: 300 emails/day. Absence is non-blocking:
# forms still persist to Supabase but no email is sent.
BREVO_API_KEY=

# ── Analytics ────────────────────────────────────────────────────
NEXT_PUBLIC_GA4_ID=

# ── On-demand ISR revalidation ───────────────────────────────────
# Random secret used by editorial team / CI to call POST /api/revalidate.
REVALIDATE_TOKEN=

# ── Outbound webhooks (env-gated) ────────────────────────────────
# Sent when a lead is captured. Absence = log + skip silently.
RP_WEBHOOK_URL=
PROPRELY_WEBHOOK_URL=

# ── Admin contact ────────────────────────────────────────────────
ADMIN_EMAIL=contact@propretebusiness.fr
